// ============================================================================
// Pruebas de la API de conductores (VS Code REST Client o similar)
// ============================================================================

@host = http://localhost:3000

### Listar conductores
GET {{host}}/api/conductores

### Crear conductor (201)
POST {{host}}/api/conductores
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-1001",
  "fecha_alta_licencia": "2023-03-15",
  "fecha_vencimiento_licencia": "2028-03-15"
}

### Obtener conductor por id
GET {{host}}/api/conductores/1

### Obtener conductor inexistente (debe responder 404)
GET {{host}}/api/conductores/9999

### Crear conductor con campos faltantes (debe responder 400)
POST {{host}}/api/conductores
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Gómez"
}

### Crear conductor con vencimiento anterior al alta (debe responder 400)
POST {{host}}/api/conductores
Content-Type: application/json

{
  "nombre": "Ana",
  "apellido": "Gómez",
  "numero_documento": "30998877",
  "numero_licencia": "LIC-1002",
  "fecha_alta_licencia": "2023-03-15",
  "fecha_vencimiento_licencia": "2020-03-15"
}

### Crear conductor con documento duplicado (debe responder 409)
POST {{host}}/api/conductores
Content-Type: application/json

{
  "nombre": "Otro",
  "apellido": "Pérez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-1003",
  "fecha_alta_licencia": "2023-03-15",
  "fecha_vencimiento_licencia": "2028-03-15"
}

### Actualizar conductor (200)
PUT {{host}}/api/conductores/1
Content-Type: application/json

{
  "nombre": "Juan Carlos",
  "apellido": "Pérez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-1001",
  "fecha_alta_licencia": "2023-03-15",
  "fecha_vencimiento_licencia": "2029-03-15"
}

### Actualizar conductor inexistente (debe responder 404)
PUT {{host}}/api/conductores/9999
Content-Type: application/json

{
  "nombre": "Juan",
  "apellido": "Pérez",
  "numero_documento": "30123456",
  "numero_licencia": "LIC-1001",
  "fecha_alta_licencia": "2023-03-15",
  "fecha_vencimiento_licencia": "2028-03-15"
}

### Eliminar conductor (usar un id sin viajes asociados; 200)
DELETE {{host}}/api/conductores/1

### Eliminar conductor con viajes asociados (debe responder 409)
DELETE {{host}}/api/conductores/1
