# Puerto del servidor backend
PORT=3000

# Base de datos MySQL (el esquema se crea con: npm run db:init)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tp3_vehiculos
DB_CONNECTION_LIMIT=10

# Autenticación JWT (firma HS256; expiración 4 h)
# Generar una clave nueva con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=reemplazar_por_una_clave_aleatoria_larga
JWT_EXPIRES_IN=4h
